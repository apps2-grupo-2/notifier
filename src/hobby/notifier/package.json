{
  "name": "notify-service",
  "version": "1.0.0",
  "description": "Notification microservice",
  "private": true,
  "type": "commonjs",
  "main": "src/server.js",
  "scripts": {
    "dev": "nodemon -r module-alias/register src/server.js",
    "start": "node -r module-alias/register src/server.js",
    "test": "node --test -r module-alias/register"
  },
  "_moduleAliases": {
    "@notify": "src",
    "@notifyTest": "tests"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "express": "^4.21.2",
    "module-alias": "^2.2.3",
    "pino": "^9.7.0",
    "pino-pretty": "^13.0.0",
    "zod": "^3.24.2",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "mysql2": "^3.3.0",
    "amqplib": "^0.10.3",
    "nodemailer": "^6.9.3"
  },
  "devDependencies": {
    "nodemon": "^3.1.10"
  }
}